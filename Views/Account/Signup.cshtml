@model SignupViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "_Layout";
}
<div class="auth-wrap">
    <div class="auth-card" style="max-width:520px;">
        <div class="brand">SERVIGO</div>
        <div class="subtitle">Create your account</div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger py-2">⚠ @Model.Error</div>
        }

        <form asp-controller="Account" asp-action="Signup" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input class="form-control" type="text" name="FullName" value="@Model.FullName" placeholder="e.g. Ali Hassan" required />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" name="Email" value="@Model.Email" placeholder="you@example.com" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone</label>
                    <input class="form-control" type="text" name="Phone" value="@Model.Phone" placeholder="03XXXXXXXXX" maxlength="11" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">CNIC</label>
                <input class="form-control" type="text" name="CNIC" value="@Model.CNIC" placeholder="XXXXXXXXXXXXX" maxlength="13" required />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Password</label>
                    <input class="form-control" type="password" name="Password" placeholder="At least 6 characters" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input class="form-control" type="password" name="ConfirmPassword" placeholder="Repeat password" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Account Type</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="IsProvider" id="rbCustomer" value="false" checked
                           onchange="document.getElementById('providerExt').style.display='none'">
                    <label class="form-check-label" for="rbCustomer">Customer</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="IsProvider" id="rbProvider" value="true"
                           onchange="document.getElementById('providerExt').style.display='block'">
                    <label class="form-check-label" for="rbProvider">Service Provider</label>
                </div>
            </div>

            <div id="providerExt" class="mb-3" style="display:@(Model.IsProvider ? "block" : "none")">
                <label class="form-label">Service Category</label>
                <select class="form-select" name="CategoryID">
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.CategoryID" selected="@(Model.CategoryID == c.CategoryID)">@c.CategoryName</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">CREATE ACCOUNT</button>
        </form>

        <div class="auth-switch">
            Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a>
        </div>
    </div>
</div>

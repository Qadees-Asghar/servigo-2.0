@model List<ProviderStatsRow>
@{
    Layout = "_AppLayout";
    var summary = (List<BookingSummaryRow>)ViewBag.Summary;
}

<h5 class="mb-2" style="color:var(--sv-accent)">Bookings by Status</h5>
<div class="table-wrap mb-4" style="max-width:500px;">
    <table class="table mb-0">
        <thead><tr><th>Status</th><th>Total Bookings</th></tr></thead>
        <tbody>
            @foreach (var s in summary)
            {
                <tr><td><partial name="_StatusPill" model="@s.StatusName" /></td><td>@s.TotalBookings</td></tr>
            }
        </tbody>
    </table>
</div>

<h5 class="mb-2" style="color:var(--sv-accent)">Provider Performance</h5>
<div class="table-wrap">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Provider</th><th>Category</th><th>Total</th><th>Completed</th><th>Cancelled/Rejected</th><th>Avg Rating</th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.ProviderName</td>
                    <td>@p.CategoryName</td>
                    <td>@p.TotalBookings</td>
                    <td>@p.Completed</td>
                    <td>@p.CancelledOrRejected</td>
                    <td class="stars">@(new string('★', (int)Math.Round(p.AverageRating)))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model List<CustomerRow>
@{ Layout = "_AppLayout"; }

<div class="toolbar d-flex gap-2">
    <form asp-action="Users" method="get" class="d-flex gap-2 flex-grow-1">
        <input class="form-control" style="max-width:280px;" type="text" name="search" value="@ViewBag.Search" placeholder="Search by name / email…" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a class="btn btn-outline-light" asp-action="Users">Refresh</a>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">No customers found.</div>
}
else
{
    <div class="table-wrap">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>User ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Bookings</th><th>Status</th><th>Joined</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.UserID</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@u.Phone</td>
                        <td>@u.TotalBookings</td>
                        <td>
                            @if (u.IsActive) { <span class="status-pill status-Accepted">Active</span> }
                            else { <span class="status-pill status-Cancelled">Inactive</span> }
                        </td>
                        <td class="text-secondary small">@u.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end d-flex gap-1 justify-content-end">
                            <form asp-action="ToggleUserActive" method="post" onsubmit="return confirm('Set user @u.UserID active = @(!u.IsActive)?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.UserID" />
                                <input type="hidden" name="active" value="@u.IsActive" />
                                <button class="btn btn-sm btn-outline-light">Toggle Active</button>
                            </form>
                            <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Permanently delete &quot;@u.FullName&quot; (@u.UserID)? This also removes their bookings. This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.UserID" />
                                <input type="hidden" name="fullName" value="@u.FullName" />
                                <button class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@model List<ProviderRow>
@{ Layout = "_AppLayout"; }

@if (Model.Count == 0)
{
    <div class="empty-state">No providers found.</div>
}
else
{
    <div class="table-wrap">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>User ID</th><th>Name</th><th>Category</th><th>Rating</th><th>Completed</th><th>Verified</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.UserID</td>
                        <td>@p.FullName</td>
                        <td>@p.CategoryName</td>
                        <td class="stars">@(new string('★', (int)Math.Round(p.AverageRating)))</td>
                        <td>@p.CompletedBookings</td>
                        <td>
                            @if (p.IsApproved) { <span class="status-pill status-Completed">Verified</span> }
                            else { <span class="status-pill status-Pending">Unverified</span> }
                        </td>
                        <td>
                            @if (p.IsActive) { <span class="status-pill status-Accepted">Active</span> }
                            else { <span class="status-pill status-Cancelled">Inactive</span> }
                        </td>
                        <td class="text-end d-flex gap-1 justify-content-end flex-wrap">
                            <form asp-action="SetProviderApproval" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="providerId" value="@p.ProviderID" />
                                <input type="hidden" name="approve" value="true" />
                                <button class="btn btn-sm btn-success">✔ Verify</button>
                            </form>
                            <form asp-action="SetProviderApproval" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="providerId" value="@p.ProviderID" />
                                <input type="hidden" name="approve" value="false" />
                                <button class="btn btn-sm btn-outline-light">✖ Unverify</button>
                            </form>
                            <form asp-action="ToggleProviderActive" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@p.UserID" />
                                <input type="hidden" name="active" value="@p.IsActive" />
                                <button class="btn btn-sm btn-outline-light">Toggle Active</button>
                            </form>
                            <form asp-action="DeleteProvider" method="post" onsubmit="return confirm('Delete provider &quot;@p.FullName&quot;? This also removes their services, slots, and bookings.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="providerId" value="@p.ProviderID" />
                                <input type="hidden" name="fullName" value="@p.FullName" />
                                <button class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

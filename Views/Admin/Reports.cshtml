@model List<FeedbackReportRow>
@{ Layout = "_AppLayout"; }

@if (Model.Count == 0)
{
    <div class="empty-state">No feedback or reports yet.</div>
}
else
{
    <div class="table-wrap">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Type</th><th>Subject</th><th>Description</th><th>Submitted By</th><th>Status</th><th>Date</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.ReportType</td>
                        <td>@f.Subject</td>
                        <td class="text-secondary">@f.Description</td>
                        <td>@f.SubmittedByName (@f.SubmittedBy)</td>
                        <td>
                            @if (f.IsResolved) { <span class="status-pill status-Completed">Resolved</span> }
                            else { <span class="status-pill status-Pending">Open</span> }
                        </td>
                        <td class="text-secondary small">@f.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            @if (!f.IsResolved)
                            {
                                <form asp-action="ResolveReport" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reportId" value="@f.ReportID" />
                                    <button class="btn btn-sm btn-success">✔ Resolve</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="ReopenReport" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reportId" value="@f.ReportID" />
                                    <button class="btn btn-sm btn-outline-light">✖ Reopen</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
